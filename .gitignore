# ─── Environment / Secrets ──────────────────────────────────────
# Single wildcard covers root, infra/, skills/, and any future sub-dirs
**/.env
**/.env.local
**/.env*.local

# ─── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ─── Node ───────────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/

# Exception: ship the frontend's prebuilt static export so deployers
# without Node.js can `git clone` and run `docker compose up` directly.
!frontend/agent-chat-ui/out/
!frontend/agent-chat-ui/out/**

# But re-ignore the skills folder inside out/. It's a build-time copy of
# the repo's top-level /skills/ (via a symlink in public/), so committing
# it would duplicate ~90MB. At runtime nginx serves /skills/ from a
# separate docker mount, so out/skills/ is never read.
frontend/agent-chat-ui/out/skills/

# ─── Editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ─── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Local data ─────────────────────────────────────────────────
*.db
*.sqlite
data/
logs/

# ─── Secrets ────────────────────────────────────────────────────
*.pem
*.key
secrets/
