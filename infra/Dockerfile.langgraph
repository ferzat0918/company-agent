FROM python:3.11-slim

WORKDIR /app

# Install system deps for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy backend code
COPY backend/ ./backend/

# Copy root langgraph.json (contains auth config)
COPY langgraph.json ./langgraph.json

# Bake skills and prompts into the image so prod doesn't need bind mounts.
# In dev, docker-compose.yml still bind-mounts these paths over the baked copies.
COPY skills/ ./skills/
COPY prompts/ ./prompts/

# Pre-install Python deps at build time (langgraph dev will verify/reuse)
RUN pip install --no-cache-dir -e "./backend[dev]"

# Create Docker-specific langgraph.json (extends root with checkpointer/store)
RUN echo '{"python_version":"3.11","dependencies":["./backend"],"graphs":{"company_agent":"./backend/src/graph.py:app"},"auth":{"path":"./backend/src/auth.py:auth"},"checkpointer":{"backend":"custom","path":"./backend/src/store_setup.py:create_checkpointer"},"store":{"backend":"custom","path":"./backend/src/store_setup.py:create_store"}}' > /app/langgraph-docker.json

# Expose LangGraph server port
EXPOSE 2024

# Start: initialize checkpoint/store tables (idempotent), then run the server.
# This means a fresh Postgres deployment needs zero manual setup.
CMD ["sh", "-c", "python /app/backend/scripts/init_db.py && exec langgraph dev --config langgraph-docker.json --host 0.0.0.0 --port 2024 --no-browser"]
