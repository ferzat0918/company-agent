# ─── Database ───────────────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_URI=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/postgres

# ─── Supabase Auth ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
SITE_URL=http://localhost:3000
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ─── DeepSeek ───────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# Multi-key round-robin (optional): comma-separated API keys for load balancing
# When set, requests are distributed across keys to increase concurrency.
# DEEPSEEK_API_KEYS=sk-key1,sk-key2,sk-key3

# ─── LangSmith (optional, for tracing) ──────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=company-agent-dev

# ─── Figma (optional, for brand asset export) ───────────────────
FIGMA_TOKEN=your_figma_personal_access_token
FIGMA_FILE_KEY=your_figma_file_key
