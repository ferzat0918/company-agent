# ─── Database ───────────────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_URI=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/postgres

# ─── Supabase Auth ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
SITE_URL=http://localhost:3000
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ─── DeepSeek ───────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# Multi-key round-robin (optional): comma-separated API keys for load balancing
# When set, requests are distributed across keys to increase concurrency.
# DEEPSEEK_API_KEYS=sk-key1,sk-key2,sk-key3

# ─── Tavily Web Search (optional, agents get web search if set) ─
# Get a key at https://tavily.com — 1000 free searches/month.
# Leave blank to disable web search; the agent still works without it.
TAVILY_API_KEY=

# ─── LangSmith (optional, for tracing) ──────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=company-agent-dev

# ─── Cloudflare Tunnel (optional, for public access) ────────────
# Leave blank to skip public exposure — the cloudflared container will
# exit and the LAN deployment continues to work normally.
# To enable: Cloudflare dashboard → Zero Trust → Networks → Tunnels →
# create a tunnel and paste the token shown right after creation.
CLOUDFLARED_TOKEN=

# ─── Figma (optional, for brand asset export) ───────────────────
FIGMA_TOKEN=your_figma_personal_access_token
FIGMA_FILE_KEY=your_figma_file_key

# ─── Deployment (only needed for docker-compose.prod.yml) ───────
# Semver tag of the release you want to run. Must match a tag pushed to GHCR.
APP_VERSION=0.1.0
# Image registry prefix. For GHCR: ghcr.io/<github-user-or-org>
IMAGE_REGISTRY=ghcr.io/ferzat0918
# Public URL the LAN reaches this host at. Used by gotrue for callback URLs.
# Example: http://192.168.1.50  (no trailing slash)
# SITE_URL is reused from the Supabase Auth section above.
# Public URL of the Supabase API gateway (Kong, port 8000).
KONG_PUBLIC_URL=http://192.168.1.50:8000
# Pin Supabase Studio to a specific build (avoid :latest in prod).
STUDIO_VERSION=2025.10.27-sha-replace-me

# ─── Daytona Sandbox (required for secure code-execution sandbox) 
# Get an API key from https://app.daytona.io
DAYTONA_API_KEY=your_daytona_api_key_here
DAYTONA_API_URL=https://app.daytona.io/api

